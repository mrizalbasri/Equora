APP_NAME="Equora API"
# Generate a random local secret for authenticated imports; never commit the real value.
# ADMIN_TOKEN=GENERATE_LOCALLY
# Configure the Equora target on the existing shared PostgreSQL after provisioning.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5434/equora
# DOCKER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres-local:5432/equora
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@127.0.0.1:5434/equora_test
POSTGRES_NETWORK=tera_default
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Optional absolute path; defaults to the repository's data directory.
# DATA_DIR=D:/Coding/Equora/data
API_PORT=8000
# Global POST budget per API process; configure edge limits across replicas too.
WRITE_REQUESTS_PER_MINUTE=60
# Existing scenarios are preserved; new saves are rejected at this capacity.
MAX_SAVED_SCENARIOS=10000
# Keep false for private local review; public deployments must use true.
REQUIRE_PUBLISHED_DATA=false
